{
  "$schema": "../node_modules/@tauri-apps/cli/config.schema.json",
  "productName": "Yomika",
  "version": "0.1.0",
  "identifier": "app.yomika.reader",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:27790",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "withGlobalTauri": false,
    "windows": [
      {
        "label": "main",
        "title": "Yomika",
        "width": 1180,
        "height": 760,
        "minWidth": 760,
        "minHeight": 560,
        "resizable": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; img-src 'self' asset: https: data:; style-src 'self' 'unsafe-inline'; font-src 'self' data:; connect-src ipc: http://ipc.localhost"
    }
  },
  "bundle": {
    "active": false
  }
}
