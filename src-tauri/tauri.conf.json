{
  "$schema": "../node_modules/@tauri-apps/cli/config.schema.json",
  "productName": "Yomika",
  "version": "1.0.0",
  "identifier": "app.yomika.reader",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:27790",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "withGlobalTauri": false,
    "windows": [
      {
        "label": "main",
        "create": false,
        "title": "Yomika",
        "width": 1180,
        "height": 760,
        "x": -2520,
        "y": 420,
        "minWidth": 760,
        "minHeight": 560,
        "resizable": true,
        "backgroundColor": "#0B0B0F"
      }
    ],
    "security": {
      "csp": "default-src 'self'; img-src 'self' asset: https: data: blob: yomika-image:; style-src 'self' 'unsafe-inline'; font-src 'self' data:; connect-src ipc: http://ipc.localhost https://fastly.jsdelivr.net"
    }
  },
  "bundle": {
    "active": false,
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}