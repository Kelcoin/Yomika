# Local architecture and migration documents（架构、审计与迁移笔记只在本地，不随仓库走）。
/docs/*

# Planning state
/.planning/
/debug_outputs/

# Local verification, packaging and one-off debug outputs
# 构建/调试日志（根目录的 `build-exe.log`、`.codex-*.log`、`.mobile-*.log`、
# `.startup-*.log` 都在这一类里）与 tsc 的增量缓存只留在本地，不要 add 回来。
/artifacts/
*.log

# AI agent tooling (local state only; negate a rule if one is ever meant to be shared)
/.claude/
/.cursor/
/.cursorrules
/.windsurf/
/.windsurfrules
/.gemini/
/.zcode/
CLAUDE.local.md

# Local generated previews and skill work
/.skill-archive/
/.superpowers/
/docs/superpowers/

# Local build helpers: entrypoint, one-off packaging, model pipeline, and the
# portable toolchain under tools/windows/toolchain/. The Windows build script is
# the one piece the repository needs, so it is checked in at
# .github/scripts/build-windows.ps1; nothing else under tools/ is tracked.
/build_exe.bat
/build_apk.bat
/tools/

# Secrets and local environment
.env
.env.*
!.env.example

# Build artifacts
/dist/
/target/
/src-tauri/target/
/src-tauri/target-fixed/
# 集成测试用相对的 CARGO_TARGET_DIR 编 worker 时，CWD 是 src-tauri，于是
# cargo 在这里又开了一棵 1 GiB 上下的 target 树。它是构建产物，不进仓库。
/src-tauri/debug_outputs/
/src-tauri/crates/*/target/
/node_modules/
/.vite-cache/
/.npm-cache/
src-tauri/.npm-cache/
*.tsbuildinfo
.codex-gh/
/vite.config.js
/vitest.config.js
/vite.config.d.ts
/vitest.config.d.ts

# OS/editor
.DS_Store
Thumbs.db
.idea/
.vscode/

# Android 签名：release 密钥与它在本地的口令文件都只在这台机器上。
# CI 构建时会往这里写一份（从 secret 解出来），本地测试密钥也放这里——都不进仓库。
/src-tauri/gen/android/release.keystore
/src-tauri/gen/android/keystore.local.properties
/src-tauri/gen/android/app/src/main/jniLibs/

# 本机运行时留下的目录。NGX/DLSS 会在「当前工作目录」旁建一个空的
# `NVIDIA Corporation/`（仓库根、src-tauri/、src-tauri/worker/ 都出现过），
# 别的本机工具也会落自己的目录：都不进远端。不加前导斜杠，因为它在仓库里
# 出现的位置不固定。
NVIDIA Corporation/
/.agents/

# scripts/ 整个目录只在本地跑：里面是一次性的取证与变异检查脚本（task*-mutation-check.ps1
# 之类），不随仓库走。2026-10-21 把此前被跟踪的那批请出了仓库（本地文件都还在）；整轮
# 验证入口也搬到了 `.github/scripts/verify-round.ps1`（那四条读它的契约跟着改了路径），
# 所以这里不再需要例外。
/scripts/
